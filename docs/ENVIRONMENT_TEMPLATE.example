# Application
APP_ENV=development
DATABASE_URL=sqlite:///./ai_adaptive_learning.db
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Authentication
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# AI providers (keep real secrets in local .env only; never commit .env)
LLM_PROVIDER=google
GEMINI_API_KEY=
OPENAI_API_KEY=
YOUTUBE_API_KEY=

# Set true only for local development. Code execution must be sandboxed before production.
ENABLE_UNSAFE_CODE_RUNNER=true
