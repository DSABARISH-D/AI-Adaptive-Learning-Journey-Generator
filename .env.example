# Application
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/adaptive_learning
JWT_SECRET=replace-with-a-secure-random-secret
AUTH_SECRET=replace-with-a-secure-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# AWS / Strands / Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
OAUTH_REDIRECT_URL=http://localhost:8000/api/auth/google/callback

# AI Providers (LLM_PROVIDER: "google", "openai", "bedrock", or "strands")
LLM_PROVIDER=google
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# External Resource Retrieval
YOUTUBE_API_KEY=your-youtube-api-key

# Optional Firebase Firestore event store for frontend learning activity
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
